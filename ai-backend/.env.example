# Copy to .env locally. Never commit real credentials.
# OpenAI is the selected model provider. Keep this key server-side only.
OPENAI_API_KEY=
MASTRA_MODEL=openai/gpt-4.1-mini

# Composio — inactive until OAuth auth configs and tool allowlists are approved
COMPOSIO_API_KEY=

# Mem0 — use namespaced IDs to isolate each application and tenant
MEM0_API_KEY=

# Langfuse — secret keys stay server-side only; SDK wiring is pending version pinning
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Supabase Auth verification for the future HTTP gateway
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
